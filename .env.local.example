# Copier ce fichier en ".env.local" (déjà dans .gitignore, jamais commité) et remplir
# les vraies valeurs. Ne JAMAIS coller de vraies clés dans le chat / un ticket / un
# fichier suivi par git — uniquement ici en local, et dans Vercel → Project Settings
# → Environment Variables pour la prod.

# Fournie automatiquement par Vercel quand tu provisionnes une base Postgres (Neon)
# depuis le dashboard (Storage -> Postgres) -- pas besoin de la saisir à la main sur
# Vercel, seulement ici en local (Vercel a un bouton "Copy .env.local" pour ça).
# DATABASE_URL est le nom de variable Neon ; certaines versions de l'intégration
# Vercel injectent encore POSTGRES_URL -- lib/db.js accepte les deux.
DATABASE_URL=

# Secret utilisé pour signer les cookies de session (admin + client). Générer une
# valeur aléatoire longue, ex. : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# YouCan Pay — laisser vide tant que le compte marchand n'existe pas. Tant que
# YOUCANPAY_SECRET_KEY est vide, /api/checkout ne tente jamais d'appeler YouCan Pay :
# la commande est créée avec payment_status="awaiting_gateway_setup" et un message
# honnête est affiché au client. Voir lib/youcanpay.js.
YOUCANPAY_PUBLIC_KEY=
YOUCANPAY_SECRET_KEY=
# Optionnel, nécessaire seulement pour la vérification serveur des webhooks (voir
# lib/youcanpay.js) -- obtenu via le flux OAuth de YouCan Pay, pas juste la clé privée.
YOUCANPAY_ACCESS_TOKEN=

# URL publique du site une fois déployé (utilisée pour construire les URLs de
# retour/webhook envoyées à YouCan Pay). En local avec `vercel dev`, laisser vide --
# le code retombe sur l'origine de la requête.
PUBLIC_BASE_URL=
