# Port HTTP du serveur Node
PORT=8787
# Taille maximale d'un fichier importé (Mo)
MAX_UPLOAD_MB=1024
# Taille maximale d'un fichier distant (lien direct, Mo)
MAX_REMOTE_MB=500
# Durée maximale traitée (minutes)
MAX_DURATION_MIN=120
# Durée de conservation des fichiers temporaires (minutes)
FILE_TTL_MIN=60
# Requêtes API par minute et par IP
RATE_LIMIT_PER_MIN=60
# Chemins des binaires (facultatif)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
